{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=600" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/cleanup?secret=[REDACTED]&dryRun=false",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=verify-evening",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=verify-morning",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=verify-night",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/generate-daily?secret=[REDACTED]",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=update-fundamentals",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=telegram-summary",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=telegram-valuebets",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/tennis-auto-publish?secret=[REDACTED]&mode=major",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/tennis-auto-publish?secret=[REDACTED]&mode=summary",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=telegram-summary",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=telegram-kamikaze",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/tennis-auto-publish?secret=[REDACTED]&mode=valuebets",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=telegram-summary",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron?secret=[REDACTED]&action=telegram-valuebets",
      "schedule": "0 19 * * *"
    }
  ]
}
